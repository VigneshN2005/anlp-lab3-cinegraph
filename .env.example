# Copy to .env for local runs, or add these in Vercel > Project > Settings > Environment Variables.
# Leave the Neo4j block empty to run on the bundled offline replica of the Movies graph.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Any OpenAI-compatible chat API. Default is Groq (free key at console.groq.com).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
